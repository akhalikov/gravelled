{
  "uid": "gravelled-overview",
  "title": "Gravelled — Riding Overview",
  "tags": ["gravelled", "cycling"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": { "from": "now-2y", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Rides",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Rides\" FROM rides;"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total distance (km)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(sum(distance_km)::numeric, 0) AS \"Total km\" FROM rides;"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total elevation gain (m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(sum(elevation_gain_m)::numeric, 0) AS \"Elevation (m)\" FROM rides;"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total moving hours (h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round((sum(duration_s)/3600.0)::numeric, 1) AS \"Hours\" FROM rides;"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Weekly distance (km)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": { "defaults": { "unit": "lengthkm", "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT week AS time, distance_km AS \"Distance (km)\" FROM ride_weekly ORDER BY 1;"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Weekly training load",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT week AS time, training_load AS \"Training load\" FROM ride_weekly ORDER BY 1;"
        }
      ]
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Time in HR zones (hours)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": { "defaults": { "unit": "h" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "pieType": "donut", "legend": { "displayMode": "list", "placement": "right", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 'Zone ' || zone AS metric, round((sum(seconds)/3600.0)::numeric, 2) AS value FROM activity_hr_zones z JOIN rides r USING (activity_id) GROUP BY zone ORDER BY zone;"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Avg speed vs avg HR (per ride)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "points", "pointSize": 6, "lineWidth": 1, "spanNulls": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Avg speed (km/h)" }, "properties": [ { "id": "unit", "value": "velocitykmh" } ] },
          { "matcher": { "id": "byName", "options": "Avg HR" }, "properties": [ { "id": "unit", "value": "bpm" }, { "id": "custom.axisPlacement", "value": "right" } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT start_time_local AS time, avg_speed_kmh AS \"Avg speed (km/h)\", average_hr AS \"Avg HR\" FROM rides ORDER BY 1;"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Rides by bike",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(gear_name, '(untagged)') AS \"Bike\", count(*) AS \"Rides\", round(sum(distance_km)::numeric, 0) AS \"km\", round(sum(elevation_gain_m)::numeric, 0) AS \"Elev (m)\" FROM rides GROUP BY 1 ORDER BY 3 DESC NULLS LAST;"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent rides",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "postgres", "uid": "gravelled-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "gravelled-pg" },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT start_time_local AS \"Date\", name AS \"Name\", gear_name AS \"Bike\", round(distance_km::numeric, 2) AS \"km\", round(avg_speed_kmh::numeric, 1) AS \"km/h\", average_hr AS \"Avg HR\", max_hr AS \"Max HR\", round(activity_training_load::numeric, 0) AS \"Load\" FROM rides ORDER BY start_time_gmt DESC LIMIT 25;"
        }
      ]
    }
  ]
}
